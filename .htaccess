# Hostinger Apache / LiteSpeed Web Server Configuration for devRasen Portfolio

# 1. Enable Mod_deflate / Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 2. Cache-Control & Expirations (Prevent stale CSS/JS issues)
<IfModule mod_headers.c>
  # Ensure browser revalidates CSS/JS when updated
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=604800, public, must-revalidate"
  </FilesMatch>
</IfModule>

# 3. Default Encoding
AddDefaultCharset UTF-8

# 4. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
